# Copia este archivo como terraform.tfvars y ajusta tu host.
# terraform.tfvars está ignorado por Git.

path_to_image      = "/ruta/al/directorio/de/la/imagen"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
pool_name           = "pool"

memory_mb   = 12288
vcpu        = 4
disk_size_gb = 30

private_network_name  = "privada"
netstack_network_name = "netstack"
private_ipv4           = "192.168.100.5"
private_gateway_ipv4   = "192.168.100.1"
netstack_ipv4          = "172.24.4.1"

# Normalmente no hace falta cambiarlo.
libvirt_uri = "qemu:///system"
